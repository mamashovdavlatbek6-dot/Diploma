# Public base URL used for canonical links, sitemap and OG tags (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Used from phase 2 onward (all optional; the app works without them) ---
# Bearer token required by POST /api/ingest. Generate: openssl rand -hex 32
INGEST_TOKEN=
# Bearer token required for mutations (PATCH /api/incidents/[id]).
ADMIN_TOKEN=
# Upstash Redis REST for shared rate limits / sliding-window state (in-memory fallback if empty).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mask last IPv4 octet in public responses: "true" | "false".
IP_MASKING=false
# Telegram notifications for critical/high incidents and the contact form.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic Slack/Discord-compatible webhook URL.
WEBHOOK_URL=
# Optional threat-intel enrichment.
ABUSEIPDB_API_KEY=
# Analytics (cookie banner appears only if one is set).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
