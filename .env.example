# Public canonical URL; no trailing slash. Production uses the actual Vercel alias.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only ingest secret, minimum 16 characters; empty disables ingest with 503.
INGEST_TOKEN=
# Server-only mutation secret, minimum 16 characters; empty disables PATCH with 503.
ADMIN_TOKEN=
# Capped event retention: 100..50000 (default 5000).
STORE_CAPACITY=5000
# Best-effort /tmp snapshot; false disables it. Never durable or cross-instance.
STORE_PERSIST=true
# Shared sliding windows, statuses, baselines and rate limits; both required.
UPSTASH_REDIS_REST_URL=
# Server-only Redis REST bearer token.
UPSTASH_REDIS_REST_TOKEN=
# Optional durable Supabase store: apply supabase/schema.sql, set both variables.
SUPABASE_URL=
# Secret service role key; never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Mask public IPv4 to /24 and IPv6 to /48. API/file reports follow the same setting.
IP_MASKING=false
# Optional notifications for real high/critical incidents and contact submissions.
TELEGRAM_BOT_TOKEN=
# Telegram destination chat ID; no delivery requests without token and chat.
TELEGRAM_CHAT_ID=
# Optional Slack/Discord-compatible HTTPS webhook URL.
WEBHOOK_URL=
# Optional HTTPS Feodo-style JSON or plain IP/CSV feed, cached for one hour.
THREAT_INTEL_FEED_URL=
# Optional reputation enrichment on ingest only, up to 3 public IPs per batch.
ABUSEIPDB_API_KEY=
# Analytics are loaded only after consent; invalid IDs are ignored.
NEXT_PUBLIC_GA4_ID=
# Numeric Yandex Metrika counter ID.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Enable Vercel Web Analytics in the dashboard before setting true.
NEXT_PUBLIC_VERCEL_ANALYTICS=false
# Public diploma metadata. Unknown values are honestly shown as not specified.
DIPLOMA_AUTHOR=Davlatbek Mamashov
# Public supervisor name, optional.
DIPLOMA_SUPERVISOR=
# Public university name, optional.
DIPLOMA_UNIVERSITY=
# Optional public business email for the About page.
CONTACT_EMAIL=
# Optional public Telegram username (without @); controls the floating link.
NEXT_PUBLIC_TELEGRAM_USERNAME=
# Optional public WhatsApp number (international digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER=
